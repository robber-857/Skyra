{{ 'skyra.css' | asset_url | stylesheet_tag }}
{{ 'skyra-about.css' | asset_url | stylesheet_tag }}
<script src="{{ 'skyra.js' | asset_url }}" defer="defer"></script>
<div class="skyra-home about-page" data-section-id="{{ section.id }}">
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header site-header--complete" data-header>
      <a class="brand" href="{{ routes.root_url }}" aria-label="Skyra Studio home">
        <img src="{{ 'skyra-logo.png' | asset_url }}" alt="" width="208" height="208" />
      </a>

      <nav class="header-links" aria-label="Featured navigation">
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
        {% endfor %}
      </nav>

      <div class="header-actions">
        <nav class="header-utilities" aria-label="Store and account navigation">
          <a href="{{ routes.search_url }}" aria-label="Search products">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.2"></circle><path d="m15.4 15.4 4.1 4.1"></path></svg>
          </a>
          <a href="{{ routes.cart_url }}" aria-label="View shopping cart">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.8 5.2h2l1.7 9.2h9.2l2-6.6H7"></path><circle cx="9.3" cy="18.5" r="1"></circle><circle cx="16.2" cy="18.5" r="1"></circle></svg>
          </a>
          <a href="{{ routes.account_url }}" aria-label="Member account">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.4"></circle><path d="M5.8 19.2c.8-3.3 3-5 6.2-5s5.4 1.7 6.2 5"></path></svg>
          </a>
        </nav>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
          <span class="menu-toggle__lines" aria-hidden="true"><i></i><i></i></span>
          <span class="menu-toggle__label">More</span>
        </button>
      </div>

      <nav class="primary-nav" id="primary-navigation" aria-label="Menu navigation" aria-hidden="true" inert>
        <div class="primary-nav__shell">
          <div class="primary-nav__links">
            {% for link in section.settings.menu.links %}
              <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}><strong>{{ link.title }}</strong></a>
            {% endfor %}
          </div>
          <div class="primary-nav__meta">
            <a href="{{ routes.collections_url }}">Online store</a>
            <a href="{{ routes.account_url }}">Member account</a>
          </div>
        </div>
      </nav>
    </header>
<main id="main" class="about-main">
      <section class="about-hero reveal" aria-labelledby="about-title">
        <div class="about-hero__copy">
          <p class="about-eyebrow">Skyra Studio is a founder-led space</p>
          <h1 id="about-title"><span>Shaped by</span><span>Long-term vision</span></h1>
          <span class="about-accent-line" aria-hidden="true"></span>
        </div>
        <figure class="about-hero__media">
          <img
            src="{{ 'skyra-about-dance-group.png' | asset_url }}"
            alt="A group dance class moving together"
            width="1200"
            height="600"
            fetchpriority="high"
          />
        </figure>
      </section>

      <section class="about-story about-split reveal" aria-labelledby="story-title">
        <div class="about-split__copy">
          <span class="about-section-mark" aria-hidden="true">S</span>
          <h2 id="story-title">Our Story</h2>
          <p>
            Skyra Studio was created as a space for intentional movement and refined expression. We believe growth happens quietly through consistency, mindfulness and care. Rather than following trends, Skyra focuses on building a studio with lasting value.
          </p>
        </div>
        <figure class="about-split__media">
          <img
            src="{{ 'skyra-about-classroom.png' | asset_url }}"
            alt="Students moving together in a mirrored dance studio"
            width="1200"
            height="600"
          />
        </figure>
      </section>

      <section class="about-philosophy about-split about-split--reverse reveal" aria-labelledby="philosophy-title">
        <figure class="about-split__media">
          <img
            src="{{ 'skyra-about-philosophy.png' | asset_url }}"
            alt="Students enjoying a dance fitness class"
            width="1200"
            height="600"
          />
        </figure>
        <div class="about-split__copy">
          <span class="about-section-mark" aria-hidden="true">P</span>
          <h2 id="philosophy-title">Our Philosophy</h2>
          <p>
            At Skyra, movement is not about performance alone, but about presence and confidence. We value structure that supports sustainable inner growth. Every program is designed to support long-term practice in a calm and considered environment.
          </p>
        </div>
      </section>

      <section class="about-programs about-split reveal" aria-labelledby="programs-title">
        <div class="about-split__copy">
          <span class="about-section-mark" aria-hidden="true">M</span>
          <h2 id="programs-title">Our Programs</h2>
          <p>
            Skyra Studio offers small-group programs in K-pop, aerial movement and mindful body practices. Classes are curated with limited group sizes to support focus, quality and personal growth. We prioritise experience and intention over volume.
          </p>
          <a class="about-text-link" href="{{ section.settings.programs_link | default: '/pages/programs' }}">Explore programs</a>
        </div>
        <figure class="about-split__media">
          <img
            src="{{ 'skyra-about-dance-group.png' | asset_url }}"
            alt="A lively group dance class"
            width="1200"
            height="600"
          />
        </figure>
      </section>

      <section class="about-cta reveal" aria-labelledby="about-cta-title">
        <div class="about-cta__copy">
          <h2 id="about-cta-title">Discover the joy of dance at Skyra Studio</h2>
          <p>
            Skyra is designed for people who value refinement, consistency and meaningful progress. Experience movement with thoughtful guidance and room to grow.
          </p>
          <a class="about-button" href="{{ section.settings.membership_link | default: '/pages/membership' }}">View membership</a>
        </div>
      </section>

      <section class="about-team reveal" aria-labelledby="team-title">
        <header class="about-team__header">
          <p class="about-eyebrow">The people behind the practice</p>
          <h2 id="team-title">Meet our instructors</h2>
        </header>

        <div class="about-team__grid">
          <article class="about-team-card">
            <img
              src="{{ 'skyra-about-winny.png' | asset_url }}"
              alt="Winny in a performance portrait"
              width="600"
              height="300"
            />
            <div>
              <h3>Founder-led teaching</h3>
              <p>
                Small-group teaching creates space for thoughtful progression, individual attention and a practice that can develop over time.
              </p>
            </div>
          </article>

          <article class="about-team-card">
            <img
              src="{{ 'skyra-about-instructors.png' | asset_url }}"
              alt="Students moving together in a mirrored dance studio"
              width="600"
              height="300"
            />
            <div>
              <h3>Considered instruction</h3>
              <p>
                Our instructors support students with clear structure, mindful pacing and a personal approach to movement and expression.
              </p>
            </div>
          </article>
        </div>
      </section>

      <section class="about-careers reveal" aria-labelledby="careers-title">
        <div class="about-careers__intro">
          <p class="about-eyebrow">We're hiring</p>
          <h2 id="careers-title">Join our team</h2>
          <span class="about-accent-line" aria-hidden="true"></span>
          <p>If you're interested in one of our open positions, tell us about your movement practice and teaching experience.</p>
          <p class="about-careers__note">Skyra Studio is a founder-led space shaped by long-term vision and considered design.</p>
        </div>

        <form class="about-application" novalidate data-application-form>
          <h3>Apply now</h3>
          <div class="about-application__grid">
            <div class="about-field">
              <label class="about-visually-hidden" for="application-name">Name</label>
              <input id="application-name" name="name" type="text" autocomplete="name" placeholder="Name" />
            </div>
            <div class="about-field">
              <label class="about-visually-hidden" for="application-phone">Phone</label>
              <input id="application-phone" name="phone" type="tel" autocomplete="tel" placeholder="Phone" />
            </div>
            <div class="about-field about-field--wide">
              <label class="about-visually-hidden" for="application-email">Email</label>
              <input
                id="application-email"
                name="email"
                type="email"
                autocomplete="email"
                placeholder="Email*"
                required
                aria-describedby="application-status"
                data-application-email
              />
            </div>
            <div class="about-field about-field--wide">
              <label class="about-visually-hidden" for="application-message">Message</label>
              <textarea id="application-message" name="message" rows="3" placeholder="Message"></textarea>
            </div>
            <div class="about-field about-field--wide about-field--file">
              <span class="about-field__label" id="application-file-label">Resume or supporting file</span>
              <input
                class="about-file-input"
                id="application-file"
                name="attachment"
                type="file"
                accept=".pdf,.doc,.docx"
                aria-labelledby="application-file-label"
                data-application-file
              />
              <label class="about-file-control" for="application-file">
                <span class="about-file-button">Choose file</span>
                <span class="about-file-name" data-application-file-name>No file chosen</span>
              </label>
            </div>
          </div>
          <button class="about-submit" type="submit" data-application-submit>
            <span>Submit application</span>
          </button>
          <p class="about-application__status" id="application-status" role="status" hidden data-application-status></p>
          <p class="about-application__privacy">Application preview only. Your details and file stay on this device.</p>
        </form>
      </section>
    </main>
    <footer class="site-footer">
      <div class="footer-main">
        <div class="footer-brand">
          <img src="{{ 'skyra-logo.png' | asset_url }}" alt="Skyra Studio" width="208" height="208" loading="lazy" />
          <p>Where movement becomes expression.</p>
          <nav class="footer-socials" aria-label="Social media">
            <a href="{{ section.settings.instagram_url | default: 'https://www.instagram.com/' }}" aria-label="Instagram"><img src="{{ 'skyra-instagram.svg' | asset_url }}" width="24" height="24" alt="" /></a>
            <a href="{{ section.settings.xiaohongshu_url | default: 'https://www.xiaohongshu.com/' }}" aria-label="Rednote"><img src="{{ 'skyra-xiaohongshu.svg' | asset_url }}" width="24" height="24" alt="" /></a>
            <a href="{{ section.settings.facebook_url | default: 'https://www.facebook.com/' }}" aria-label="Facebook"><img src="{{ 'skyra-facebook.svg' | asset_url }}" width="24" height="24" alt="" /></a>
            <a href="{{ section.settings.tiktok_url | default: 'https://www.tiktok.com/' }}" aria-label="TikTok"><img src="{{ 'skyra-tiktok.svg' | asset_url }}" width="24" height="24" alt="" /></a>
          </nav>
        </div>

        <nav class="footer-navigation" aria-label="Footer navigation">
          <div class="footer-group">
            <p class="footer-heading">Explore</p>
            <a href="{{ routes.root_url }}">Home</a>
            <a href="{{ section.settings.programs_link | default: '/pages/programs' }}">Programs</a>
            <a href="{{ section.settings.membership_link | default: '/pages/membership' }}">Membership</a>
            <a href="{{ section.settings.mv_project_link | default: '/pages/mv-project' }}">MV Project</a>
          </div>
          <div class="footer-group">
            <p class="footer-heading">Studio</p>
            <a href="{{ section.settings.about_link | default: '/pages/about-us' }}">About Skyra</a>
            <a href="{{ section.settings.functions_link | default: '/pages/functions-studio-hire' }}">Functions &amp; Studio Hire</a>
            <a href="{{ section.settings.contact_link | default: '/pages/contact' }}">Contact</a>
          </div>
          <div class="footer-group">
            <p class="footer-heading">Account</p>
            <a href="{{ routes.collections_url }}">Online store</a>
            <a href="{{ routes.account_url }}">Member account</a>
          </div>
        </nav>

        <address class="footer-visit">
          <p class="footer-heading">Visit Skyra</p>
          <p class="footer-email"><a href="mailto:hello@skyrastudio.com.au">hello@skyrastudio.com.au</a></p>
          <p>Commercial Building, Level 12</p>
          <p>1202/180-186 Burwood Rd</p>
          <p>Burwood NSW 2134</p>
        </address>
      </div>
      <div class="footer-bottom">
        <p class="footer-copyright">Copyright © 2026 Skyra Studio. All rights reserved.</p>
        <nav class="footer-legal" aria-label="Legal">
          <a href="{{ shop.policies.privacy_policy.url | default: '/policies/privacy-policy' }}">Privacy Policy</a>
          <a href="{{ shop.policies.terms_of_service.url | default: '/policies/terms-of-service' }}">Terms &amp; Conditions</a>
        </nav>
      </div>
    </footer>
</div>
{% schema %}
{
  "name": "Skyra about",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Main menu", "default": "main-menu" },
    { "type": "url", "id": "programs_link", "label": "Programs page" },
    { "type": "url", "id": "membership_link", "label": "Membership page" },
    { "type": "url", "id": "mv_project_link", "label": "MV Project page" },
    { "type": "url", "id": "functions_link", "label": "Functions and Studio Hire page" },
    { "type": "url", "id": "about_link", "label": "About page" },
    { "type": "url", "id": "contact_link", "label": "Contact page" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "xiaohongshu_url", "label": "Rednote URL" },
    { "type": "url", "id": "facebook_url", "label": "Facebook URL" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok URL" }
  ],
  "presets": [{ "name": "Skyra about" }],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
