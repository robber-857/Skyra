{{ 'skyra.css' | asset_url | stylesheet_tag }}
{{ 'skyra-membership.css' | asset_url | stylesheet_tag }}
{{ 'skyra-membership-purchase.css' | asset_url | stylesheet_tag }}
<script src="{{ 'skyra-memberships.js' | asset_url }}" defer="defer"></script>
<div class="skyra-home membership-page membership-page--purchase">
  <div class="membership-main">
    <section class="membership-catalog membership-purchase" id="membership-purchase-{{ section.id }}" aria-label="Buy a pass">
      <div id="skyra-memberships-{{ section.id }}" class="membership-shop" data-skyra-memberships data-proxy-base="/apps/skyra-booking" data-shop-domain="{{ shop.permanent_domain | escape }}" data-theme-id="{{ theme.id }}">
        <p class="membership-shop__notice"><a href="{{ section.settings.contact_link | default: '/pages/contact' }}">{{ 'actions.view_store_information' | t }}</a></p>
      </div>
    </section>
  </div>
</div>
{% schema %}
{
  "name": "Skyra pass purchase",
  "settings": [
    { "type": "url", "id": "contact_link", "label": "Contact page" }
  ],
  "presets": [{ "name": "Skyra pass purchase" }],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}

