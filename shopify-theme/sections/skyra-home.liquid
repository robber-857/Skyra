{{ 'skyra.css' | asset_url | stylesheet_tag }}
<script src="{{ 'skyra.js' | asset_url }}" defer="defer"></script>
<div class="skyra-home" data-section-id="{{ section.id }}">
<a class="skip-link" href="#main">Skip to main content</a>

    <header class="site-header site-header--complete" data-header>
      <a class="brand" href="{{ routes.root_url }}" aria-label="Skyra Studio home">
        <img src="{{ 'skyra-logo.png' | asset_url }}" alt="Skyra" width="208" height="208" />
      </a>

      <nav class="header-links" aria-label="Featured navigation">
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
        {% endfor %}
      </nav>

      <div class="header-actions">
        <nav class="header-utilities" aria-label="Store and account navigation">
          <a href="{{ routes.search_url }}" aria-label="Search products">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.2"></circle><path d="m15.4 15.4 4.1 4.1"></path></svg>
          </a>
          <a href="{{ routes.cart_url }}" aria-label="View shopping cart">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.8 5.2h2l1.7 9.2h9.2l2-6.6H7"></path><circle cx="9.3" cy="18.5" r="1"></circle><circle cx="16.2" cy="18.5" r="1"></circle></svg>
          </a>
          <a href="{{ routes.account_url }}" aria-label="Member account">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.4"></circle><path d="M5.8 19.2c.8-3.3 3-5 6.2-5s5.4 1.7 6.2 5"></path></svg>
          </a>
        </nav>
        <button
          class="menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="primary-navigation"
        >
          <span class="menu-toggle__lines" aria-hidden="true"><i></i><i></i></span>
          <span class="menu-toggle__label">More</span>
        </button>
      </div>

      <nav
        class="primary-nav"
        id="primary-navigation"
        aria-label="Menu navigation"
        aria-hidden="true"
        inert
      >
        <div class="primary-nav__shell">
          <div class="primary-nav__links">
            {% for link in section.settings.menu.links %}
              <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}><strong>{{ link.title }}</strong></a>
            {% endfor %}
          </div>
          <div class="primary-nav__meta">
            <a href="{{ routes.collections_url }}">Online store</a>
            <a href="{{ routes.account_url }}">Member account</a>
          </div>
        </div>
      </nav>
    </header>

    <div class="skyra-home__main" id="main">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="hero-media" aria-hidden="true">
          <img
            class="hero-media__image"
            src="{{ 'skyra-current-hero.jpg' | asset_url }}"
            alt=""
            width="1448"
            height="1086"
            fetchpriority="high"
          />
          <div class="hero-media__wash"></div>
        </div>

        <div class="hero-copy">
          <h1 id="hero-title">
            <span>Where movement</span>
            <span><em>becomes expression</em></span>
          </h1>
          <p class="hero-description">
            A curated studio for refined movement, presence and long-term practice.
          </p>
          <div class="hero-actions">
            <a
              class="button button--hero button--hero-primary"
              href="{{ section.settings.programs_link | default: '/pages/programs' }}"
            >
              <span>Explore programs</span>
            </a>
            <a
              class="button button--hero button--hero-secondary"
              href="{{ section.settings.membership_link | default: '/pages/membership' }}"
            >
              <span>View membership</span>
            </a>
          </div>
        </div>
      </section>

      <section class="programs section-shell" id="programs" aria-labelledby="programs-title">
        <div class="programs-copy reveal">
          <h2 id="programs-title">Find your way to move</h2>
          <div class="programs-copy__details">
            <a class="button button--outline" href="{{ section.settings.programs_link | default: '/pages/programs' }}">View programs</a>
            <p>
              Explore movement that supports how you feel, function and show up in your life.
            </p>
          </div>
        </div>

        <div
          class="circular-gallery reveal"
          data-gallery
          tabindex="0"
          role="region"
          aria-label="Skyra movement gallery. Drag or use the arrow keys to browse."
        >
          <div class="circular-gallery__stage">
            <figure class="gallery-card" data-gallery-card>
              <img src="{{ 'skyra-movement-01.jpg' | asset_url }}" width="1000" height="1000" alt="Dance fitness class in motion" />
              <figcaption>Dance fitness</figcaption>
            </figure>
            <figure class="gallery-card" data-gallery-card>
              <img src="{{ 'skyra-movement-02.jpg' | asset_url }}" width="1000" height="1000" alt="Aerial hammock class in a bright studio" />
              <figcaption>Aerial practice</figcaption>
            </figure>
            <figure class="gallery-card" data-gallery-card>
              <img src="{{ 'skyra-movement-03.jpg' | asset_url }}" width="1000" height="1000" alt="Group dance session in a studio" />
              <figcaption>Choreography</figcaption>
            </figure>
            <figure class="gallery-card" data-gallery-card>
              <img src="{{ 'skyra-movement-04.jpg' | asset_url }}" width="1000" height="1000" alt="Group movement sequence" />
              <figcaption>Creative movement</figcaption>
            </figure>
            <figure class="gallery-card" data-gallery-card>
              <img src="{{ 'skyra-movement-05.jpg' | asset_url }}" width="1000" height="1000" alt="Floorwork dance class" />
              <figcaption>Floorwork</figcaption>
            </figure>
            <figure class="gallery-card" data-gallery-card>
              <img src="{{ 'skyra-movement-06.jpg' | asset_url }}" width="1000" height="1000" alt="Flexibility class moving through a backbend" />
              <figcaption>Flexibility</figcaption>
            </figure>
          </div>
        </div>
      </section>

      <section class="story section-shell" id="story" aria-labelledby="story-title">
        <div class="story-image reveal">
          <img
            src="{{ 'skyra-movement-02.jpg' | asset_url }}" width="1000" height="1000"
            alt="Aerial movement class using suspended hammocks"
            loading="lazy"
          />
        </div>
        <div class="story-copy reveal">
          <p class="story-kicker">Our story</p>
          <h2 id="story-title">
            <span>A space for</span>
            <span>intentional</span>
            <span>movement</span>
          </h2>
          <p class="story-lead">
            Skyra was created for refined expression, meaningful progress and the confidence that grows through practice.
          </p>
          <p class="story-detail">
            We believe growth happens quietly through consistency, atmosphere and care. Rather than following trends, we are building a studio with lasting value.
          </p>
          <a class="text-link story-link" href="{{ section.settings.about_link | default: '/pages/about-us' }}">Read our story</a>
        </div>
      </section>

      <section class="schedule section-shell" id="schedule" aria-labelledby="schedule-title">
        <div class="schedule-intro reveal">
          <h2 id="schedule-title">Booking that feels like Skyra</h2>
          <p>
            A first look at the owned booking experience. Sessions below are illustrative, not live availability.
          </p>
        </div>

        <div class="schedule-demo reveal" data-schedule-demo>
          <div class="schedule-toolbar" role="group" aria-label="Filter illustrative sessions">
            <button class="filter-button is-active" type="button" data-filter="all" aria-pressed="true">All</button>
            <button class="filter-button" type="button" data-filter="morning" aria-pressed="false">Morning</button>
            <button class="filter-button" type="button" data-filter="evening" aria-pressed="false">Evening</button>
          </div>

          <div class="session-list" data-session-list>
            <article class="session-row" data-time="morning">
              <p class="session-day">Monday</p>
              <div>
                <h3>Aerial Yoga Beginner</h3>
                <p>9:30 AM · 60 minutes</p>
              </div>
              <button type="button" class="session-action" data-session="Aerial Yoga Beginner">Preview booking</button>
            </article>
            <article class="session-row" data-time="evening">
              <p class="session-day">Wednesday</p>
              <div>
                <h3>Dance Fitness</h3>
                <p>6:00 PM · 60 minutes</p>
              </div>
              <button type="button" class="session-action" data-session="Dance Fitness">Preview booking</button>
            </article>
            <article class="session-row" data-time="morning">
              <p class="session-day">Saturday</p>
              <div>
                <h3>First Intro</h3>
                <p>10:30 AM · 60 minutes</p>
              </div>
              <button type="button" class="session-action" data-session="First Intro">Preview booking</button>
            </article>
          </div>

          <div class="schedule-empty" data-schedule-empty hidden>
            <p>No sample sessions match this filter.</p>
            <button type="button" data-reset-filter>Show all sessions</button>
          </div>

          <div class="booking-preview" data-booking-preview hidden tabindex="-1">
            <p class="booking-preview__title">Booking preview</p>
            <p>
              <strong data-booking-name>Aerial Yoga Beginner</strong> selected. Live capacity, package credits and waitlist status will connect to the Skyra booking API.
            </p>
            <button type="button" data-close-preview>Close preview</button>
          </div>
        </div>
      </section>

      <section class="membership section-shell" id="membership" aria-labelledby="membership-title">
        <div class="membership-intro reveal">
          <h2 id="membership-title">Membership options</h2>
        </div>

        <div class="membership-paths">
          <article class="membership-path membership-path--classes reveal">
            <a
              class="membership-path__media"
              href="{{ section.settings.programs_link | default: '/pages/programs' }}"
              aria-label="Explore Skyra classes"
            >
              <img
                src="{{ 'skyra-movement-03.jpg' | asset_url }}" width="1000" height="1000"
                alt="Group dance class moving together in a studio"
                loading="lazy"
              />
            </a>
            <div class="membership-path__copy">
              <h3>Class passes</h3>
              <p>Intro sessions and flexible class packs.</p>
              <a class="text-link" href="{{ section.settings.programs_link | default: '/pages/programs' }}">Explore classes</a>
            </div>
          </article>

          <article class="membership-path membership-path--membership reveal">
            <a
              class="membership-path__media"
              href="{{ section.settings.membership_link | default: '/pages/membership' }}"
              aria-label="View Skyra membership"
            >
              <img
                src="{{ 'skyra-movement-02.jpg' | asset_url }}" width="1000" height="1000"
                alt="Aerial class practising with suspended hammocks"
                loading="lazy"
              />
            </a>
            <div class="membership-path__copy">
              <h3>Membership</h3>
              <p>Regular weekly practice, with room to progress.</p>
              <a class="text-link" href="{{ section.settings.membership_link | default: '/pages/membership' }}">View membership</a>
            </div>
          </article>
        </div>
      </section>

      <section class="community section-shell" id="community" aria-labelledby="community-title">
        <div class="community-showcase reveal">
          <div class="community-heading">
            <h2 id="community-title">Our community</h2>
            <div class="community-heading__social">
<a href="{{ section.settings.instagram_url | default: 'https://www.instagram.com/' }}" target="_blank" rel="noopener noreferrer">Instagram</a>
              <p class="community-heading__statement">
                <span>Real people.</span> <span>Real movement stories.</span>
              </p>
            </div>
          </div>

          <div class="community-feed{% if section.blocks.size > 0 %} community-feed--app{% endif %}" aria-label="Community social post previews">
            {% if section.blocks.size > 0 %}
              {% for block in section.blocks %}
                <div class="community-feed__app" {{ block.shopify_attributes }}>
                  {% render block %}
                </div>
              {% endfor %}
            {% else %}
<a class="community-post" href="#community" aria-label="Community post link placeholder">
              <img
                src="{{ 'skyra-movement-01.jpg' | asset_url }}" width="1000" height="1000"
                alt="Dance fitness class moving together"
                loading="lazy"
              />
            </a>
            <a class="community-post" href="#community" aria-label="Community post link placeholder">
              <img
                src="{{ 'skyra-movement-02.jpg' | asset_url }}" width="1000" height="1000"
                alt="Aerial students practising with suspended hammocks"
                loading="lazy"
              />
            </a>
            <a class="community-post" href="#community" aria-label="Community post link placeholder">
              <img
                src="{{ 'skyra-movement-03.jpg' | asset_url }}" width="1000" height="1000"
                alt="Group choreography session in the studio"
                loading="lazy"
              />
            </a>
            <a class="community-post" href="#community" aria-label="Community post link placeholder">
              <img
                src="{{ 'skyra-movement-04.jpg' | asset_url }}" width="1000" height="1000"
                alt="Community movement class in progress"
                loading="lazy"
              />
            </a>
            {% endif %}
          </div>
        </div>

        <div class="community-newsletter reveal">
          <div class="community-newsletter__copy">
            <h3>Move with us, in your inbox.</h3>
            <p>Join the Skyra list for considered updates, never noise.</p>
          </div>
          {% form 'customer', class: 'community-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label for="community-email-{{ section.id }}">Email address</label>
            <div class="community-form__row">
              <input id="community-email-{{ section.id }}" name="contact[email]" type="email" autocomplete="email" placeholder="you@example.com" required>
              <button class="button button--gold community-submit" type="submit">Join community</button>
            </div>
            {% if form.posted_successfully? %}
              <p class="community-form__status is-success" role="status">Thank you for joining the Skyra community.</p>
            {% endif %}
            {{ form.errors | default_errors }}
          {% endform %}
        </div>
      </section>
    </div>

    <footer class="site-footer" id="contact">
      <div class="footer-main">
        <div class="footer-brand">
          <img
            src="{{ 'skyra-logo.png' | asset_url }}"
            alt="Skyra Studio"
            width="208"
            height="208"
            loading="lazy"
          />
          <p>Where movement becomes expression.</p>
          <nav class="footer-socials" aria-label="Social media">
            <a href="{{ section.settings.instagram_url | default: 'https://www.instagram.com/' }}" aria-label="Instagram"><img src="{{ 'skyra-instagram.svg' | asset_url }}" width="24" height="24" alt="" /></a>
            <a href="{{ section.settings.xiaohongshu_url | default: 'https://www.xiaohongshu.com/' }}" aria-label="Rednote"><img src="{{ 'skyra-xiaohongshu.svg' | asset_url }}" width="24" height="24" alt="" /></a>
            <a href="{{ section.settings.facebook_url | default: 'https://www.facebook.com/' }}" aria-label="Facebook"><img src="{{ 'skyra-facebook.svg' | asset_url }}" width="24" height="24" alt="" /></a>
            <a href="{{ section.settings.tiktok_url | default: 'https://www.tiktok.com/' }}" aria-label="TikTok"><img src="{{ 'skyra-tiktok.svg' | asset_url }}" width="24" height="24" alt="" /></a>
          </nav>
        </div>

        <nav class="footer-navigation" aria-label="Footer navigation">
          <div class="footer-group">
            <p class="footer-heading">Explore</p>
            <a href="{{ routes.root_url }}">Home</a>
            <a href="{{ section.settings.programs_link | default: '/pages/programs' }}">Programs</a>
            <a href="{{ section.settings.membership_link | default: '/pages/membership' }}">Membership</a>
            <a href="{{ section.settings.mv_project_link | default: '/pages/mv-project' }}">MV Project</a>
          </div>

          <div class="footer-group">
            <p class="footer-heading">Studio</p>
            <a href="{{ section.settings.about_link | default: '/pages/about-us' }}">About Skyra</a>
            <a href="{{ section.settings.functions_link | default: '/pages/functions-studio-hire' }}">Functions &amp; Studio Hire</a>
            <a href="{{ section.settings.contact_link | default: '/pages/contact' }}">Contact</a>
          </div>

          <div class="footer-group">
            <p class="footer-heading">Account</p>
            <a href="{{ routes.collections_url }}">Online store</a>
            <a href="{{ routes.account_url }}">Member account</a>
          </div>
        </nav>

        <address class="footer-visit">
          <p class="footer-heading">Visit Skyra</p>
          <p>Commercial Building, Level 12</p>
          <p>1202/180-186 Burwood Rd</p>
          <p>Burwood NSW 2134</p>
        </address>
      </div>

      <div class="footer-bottom">
        <p class="footer-copyright">Copyright © 2026 Skyra Studio. All rights reserved.</p>
        <nav class="footer-legal" aria-label="Legal">
<a href="{{ shop.policies.privacy_policy.url | default: '/policies/privacy-policy' }}">Privacy Policy</a>
          <a href="{{ shop.policies.terms_of_service.url | default: '/policies/terms-of-service' }}">Terms &amp; Conditions</a>
        </nav>
      </div>
    </footer>
</div>
{% schema %}
{
  "name": "Skyra home",
  "max_blocks": 1,
  "blocks": [
    { "type": "@app" }
  ],
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Main menu", "default": "main-menu" },
    { "type": "url", "id": "programs_link", "label": "Programs page" },
    { "type": "url", "id": "membership_link", "label": "Membership page" },
    { "type": "url", "id": "mv_project_link", "label": "MV Project page" },
    { "type": "url", "id": "functions_link", "label": "Functions and Studio Hire page" },
    { "type": "url", "id": "about_link", "label": "About page" },
    { "type": "url", "id": "contact_link", "label": "Contact page" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "xiaohongshu_url", "label": "Rednote URL" },
    { "type": "url", "id": "facebook_url", "label": "Facebook URL" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok URL" }
  ],
  "presets": [{ "name": "Skyra home" }],
  "enabled_on": { "templates": ["index"] }
}
{% endschema %}