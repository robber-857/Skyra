{{ 'skyra.css' | asset_url | stylesheet_tag }}
{{ 'skyra-membership.css' | asset_url | stylesheet_tag }}
<script src="{{ 'skyra.js' | asset_url }}" defer="defer"></script>
<div class="skyra-home membership-page" data-section-id="{{ section.id }}">
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header site-header--complete" data-header>
      <a class="brand" href="{{ routes.root_url }}" aria-label="Skyra Studio home">
        <img src="{{ 'skyra-logo.png' | asset_url }}" alt="" width="208" height="208" />
      </a>

      <nav class="header-links" aria-label="Featured navigation">
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
        {% endfor %}
      </nav>

      <div class="header-actions">
        <nav class="header-utilities" aria-label="Store and account navigation">
          <a href="{{ routes.search_url }}" aria-label="Search products">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.2"></circle><path d="m15.4 15.4 4.1 4.1"></path></svg>
          </a>
          <a href="{{ routes.cart_url }}" aria-label="View shopping cart">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.8 5.2h2l1.7 9.2h9.2l2-6.6H7"></path><circle cx="9.3" cy="18.5" r="1"></circle><circle cx="16.2" cy="18.5" r="1"></circle></svg>
          </a>
          <a href="{{ routes.account_url }}" aria-label="Member account">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.4"></circle><path d="M5.8 19.2c.8-3.3 3-5 6.2-5s5.4 1.7 6.2 5"></path></svg>
          </a>
        </nav>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
          <span class="menu-toggle__lines" aria-hidden="true"><i></i><i></i></span>
          <span class="menu-toggle__label">More</span>
        </button>
      </div>

      <nav class="primary-nav" id="primary-navigation" aria-label="Menu navigation" aria-hidden="true" inert>
        <div class="primary-nav__shell">
          <div class="primary-nav__links">
            {% for link in section.settings.menu.links %}
              <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}><strong>{{ link.title }}</strong></a>
            {% endfor %}
          </div>
          <div class="primary-nav__meta">
            <a href="{{ routes.collections_url }}">Online store</a>
            <a href="{{ routes.account_url }}">Member account</a>
          </div>
        </div>
      </nav>
    </header>
<main id="main" class="membership-main">
      <section class="membership-hero reveal" id="top" aria-labelledby="membership-hero-title">
        <div class="membership-hero__copy">
          <h1 id="membership-hero-title">
            <span>Experience the Magic of</span>
            <span>SKYRA Dance Studio</span>
          </h1>
          <p>
            <span>Access to Skyra Studio is structured through membership.</span>
            <span>This allows us to maintain consistency, quality and care across all programs.</span>
          </p>
          <a class="membership-button" href="#membership-options">Experience Now</a>
        </div>
      </section>

      <section class="membership-catalog reveal" id="membership-options" aria-labelledby="membership-title">
        <header class="membership-catalog__heading">
          <span class="membership-icon membership-icon--small" aria-hidden="true">
            <svg viewBox="0 0 32 32">
              <path d="M5.5 8.5c4.2 0 7.7 1 10.5 3.6 2.8-2.6 6.3-3.6 10.5-3.6v15.2c-4.2 0-7.7 1-10.5 3.5-2.8-2.5-6.3-3.5-10.5-3.5Z"></path>
              <path d="M16 12.1v15.1M9.2 12.3c2.6.2 4.7 1 6.8 2.6M22.8 12.3c-2.6.2-4.7 1-6.8 2.6"></path>
            </svg>
          </span>
          <h2 id="membership-title">Our Membership</h2>
          <span class="membership-catalog__line" aria-hidden="true"></span>
        </header>

        <section class="membership-category membership-category--aerial" aria-labelledby="aerial-title">
          <header class="membership-category__heading">
            <span class="membership-icon" aria-hidden="true">
              <svg viewBox="0 0 32 32">
                <circle cx="16" cy="7" r="2.4"></circle>
                <path d="M16 10.3v8.3M16 13.4 9.4 6.8M16 13.4l6.6-6.6M16 18.6l-5 8.2M16 18.6l5 8.2M8.8 4.8c-.7 7.2-.3 14.9 2.2 22.2M23.2 4.8c.7 7.2.3 14.9-2.2 22.2"></path>
              </svg>
            </span>
            <div>
              <h3 id="aerial-title">Aerial Yoga</h3>
              <p>Add a description about this category</p>
            </div>
          </header>
          <article class="membership-card membership-card--intro">
            <div class="membership-card__title-row">
              <h4>Drop In （Intro）</h4>
              <p class="membership-card__price">$ 49</p>
            </div>
            <p class="membership-card__summary">Single aerial class</p>
            <p class="membership-card__terms">expires 1 month from purchase date; no refunds or exchanges</p>
          </article>
        </section>

        <section class="membership-category membership-category--packages" aria-labelledby="packages-title">
          <header class="membership-category__heading">
            <span class="membership-icon membership-icon--small" aria-hidden="true">
              <svg viewBox="0 0 32 32">
                <path d="M5 13h22v5H5zM7 18h18v10H7zM16 13v15M4 9h24v4H4z"></path>
                <path d="M16 9c-4.8 0-7.4-1.2-7.4-3.2 0-1.5 1-2.6 2.6-2.6C13.7 3.2 16 9 16 9Zm0 0c4.8 0 7.4-1.2 7.4-3.2 0-1.5-1-2.6-2.6-2.6C18.3 3.2 16 9 16 9Z"></path>
              </svg>
            </span>
            <div>
              <h3 id="packages-title">Membership Packages</h3>
              <p>Add a description about this category</p>
            </div>
          </header>
          <div class="membership-card-grid">
            <article class="membership-card">
              <div class="membership-card__title-row">
                <h4>SKYRA Flow 5 Classes</h4>
                <p class="membership-card__price">$ 220</p>
              </div>
              <p class="membership-card__summary">2-month expiry from first use</p>
              <p class="membership-card__terms">
                Aerial Pack can also be used to book for regular dance class. No holiday pauses,
                extensions, refunds, transfers or sharing of packs.
              </p>
            </article>
            <article class="membership-card">
              <div class="membership-card__title-row">
                <h4>SKYRA Signature 30 Classes 🌟🌟</h4>
                <p class="membership-card__price">$ 1080</p>
              </div>
              <p class="membership-card__summary">10-month expiry from first use</p>
              <p class="membership-card__terms">
                Aerial Pack can also be used to book for regular dance class. No holiday pauses,
                extensions, refunds, transfers or sharing of packs.
              </p>
            </article>
            <article class="membership-card">
              <div class="membership-card__title-row">
                <h4>SKYRA Elevate 10 Classes 🌟</h4>
                <p class="membership-card__price">$ 420</p>
              </div>
              <p class="membership-card__summary">4-month expiry from first use</p>
              <p class="membership-card__terms">
                Aerial Pack can also be used to book for regular dance class. No holiday pauses,
                extensions, refunds, transfers or sharing of packs.
              </p>
            </article>
            <article class="membership-card">
              <div class="membership-card__title-row">
                <h4>SKYRA Lifestyle</h4>
                <p class="membership-card__price">$ 299</p>
              </div>
              <p class="membership-card__summary">Up to 3 Aerial/Regular classes per week</p>
              <p class="membership-card__terms">
                Valid for 1 month from first use. Pass must be activated within 3 months of
                purchase. No holiday pauses, extensions, refunds, transfers or sharing of pass.
              </p>
            </article>
          </div>
        </section>

        <section class="membership-category membership-category--private" aria-labelledby="private-title">
          <header class="membership-category__heading">
            <span class="membership-icon membership-icon--small" aria-hidden="true">
              <svg viewBox="0 0 32 32">
                <circle cx="16" cy="8" r="3"></circle>
                <circle cx="7.5" cy="11" r="2.5"></circle>
                <circle cx="24.5" cy="11" r="2.5"></circle>
                <path d="M10 27v-4.5c0-4 2.3-6.3 6-6.3s6 2.3 6 6.3V27ZM2.5 25v-3.2c0-3.2 1.8-5 5-5 1.4 0 2.6.4 3.5 1.2M29.5 25v-3.2c0-3.2-1.8-5-5-5-1.4 0-2.6.4-3.5 1.2"></path>
              </svg>
            </span>
            <div>
              <h3 id="private-title">Skyra Private</h3>
              <p>Add a description about this category</p>
            </div>
          </header>
          <div class="membership-card-grid">
            <article class="membership-card">
              <div class="membership-card__title-row">
                <h4>1:1 First-Timer Offer</h4>
                <p class="membership-card__price">$ 120</p>
              </div>
              <p class="membership-card__summary">INTRO OFFER - Private class (Value at $140)</p>
              <p class="membership-card__terms">
                Aerial Yoga 1:1 - single pass for 1 person (new reformer student only). Expires 1
                month from purchase date; no refunds or exchanges.
              </p>
            </article>
            <article class="membership-card">
              <div class="membership-card__title-row">
                <h4>Semi-Private 2:1</h4>
                <p class="membership-card__price">$ 85</p>
              </div>
              <p class="membership-card__summary">INTRO OFFER - Private class</p>
              <p class="membership-card__terms">
                Aerial Yoga 2:1 - Single pass for 1 person. Pack must be activated within 2 months
                of purchase. No refunds, extensions or sharing of packs.
              </p>
            </article>
            <article class="membership-card">
              <div class="membership-card__title-row">
                <h4>5 Sessions 1:1</h4>
                <p class="membership-card__price">$ 699</p>
              </div>
              <p class="membership-card__terms">
                Aerial Yoga 1:1 - Valid for 2 months from first use. Pack must be activated within
                2 months of purchase. No refunds, extensions or sharing of packs.
              </p>
            </article>
            <article class="membership-card">
              <div class="membership-card__title-row">
                <h4>5 Sessions 2:1</h4>
                <p class="membership-card__price">$ 425</p>
              </div>
              <p class="membership-card__terms">
                Aerial Yoga 2:1 - package price for 1 person. Valid for 2 months from first use.
                Pack must be activated within 3 months of purchase. No refunds, extensions or
                sharing of packs.
              </p>
            </article>
          </div>
        </section>
      </section>

      <section class="membership-cta reveal" aria-labelledby="membership-cta-title">
        <div class="membership-cta__copy">
          <h2 id="membership-cta-title">Experience the Joy of Dance at Skyra Studio Dance Studio!</h2>
          <p>
            Welcome to Skyra Studio Dance Studio, where we believe that everyone can dance and
            experience the joy that it brings. We offer a variety of classes taught by experienced
            and enthusiastic instructors, from beginner to advanced levels. Join our community and
            let's dance together!
          </p>
        </div>
      </section>
    </main>
    <footer class="site-footer">
      <div class="footer-main">
        <div class="footer-brand">
          <img src="{{ 'skyra-logo.png' | asset_url }}" alt="Skyra Studio" width="208" height="208" loading="lazy" />
          <p>Where movement becomes expression.</p>
          <nav class="footer-socials" aria-label="Social media">
            <a href="{{ section.settings.instagram_url | default: 'https://www.instagram.com/' }}" aria-label="Instagram"><img src="{{ 'skyra-instagram.svg' | asset_url }}" width="24" height="24" alt="" /></a>
            <a href="{{ section.settings.xiaohongshu_url | default: 'https://www.xiaohongshu.com/' }}" aria-label="Rednote"><img src="{{ 'skyra-xiaohongshu.svg' | asset_url }}" width="24" height="24" alt="" /></a>
            <a href="{{ section.settings.facebook_url | default: 'https://www.facebook.com/' }}" aria-label="Facebook"><img src="{{ 'skyra-facebook.svg' | asset_url }}" width="24" height="24" alt="" /></a>
            <a href="{{ section.settings.tiktok_url | default: 'https://www.tiktok.com/' }}" aria-label="TikTok"><img src="{{ 'skyra-tiktok.svg' | asset_url }}" width="24" height="24" alt="" /></a>
          </nav>
        </div>

        <nav class="footer-navigation" aria-label="Footer navigation">
          <div class="footer-group">
            <p class="footer-heading">Explore</p>
            <a href="{{ routes.root_url }}">Home</a>
            <a href="{{ section.settings.programs_link | default: '/pages/programs' }}">Programs</a>
            <a href="{{ section.settings.membership_link | default: '/pages/membership' }}">Membership</a>
            <a href="{{ section.settings.mv_project_link | default: '/pages/mv-project' }}">MV Project</a>
          </div>
          <div class="footer-group">
            <p class="footer-heading">Studio</p>
            <a href="{{ section.settings.about_link | default: '/pages/about-us' }}">About Skyra</a>
            <a href="{{ section.settings.functions_link | default: '/pages/functions-studio-hire' }}">Functions &amp; Studio Hire</a>
            <a href="{{ section.settings.contact_link | default: '/pages/contact' }}">Contact</a>
          </div>
          <div class="footer-group">
            <p class="footer-heading">Account</p>
            <a href="{{ routes.collections_url }}">Online store</a>
            <a href="{{ routes.account_url }}">Member account</a>
          </div>
        </nav>

        <address class="footer-visit">
          <p class="footer-heading">Visit Skyra</p>
          <p class="footer-email"><a href="mailto:hello@skyrastudio.com.au">hello@skyrastudio.com.au</a></p>
          <p>Commercial Building, Level 12</p>
          <p>1202/180-186 Burwood Rd</p>
          <p>Burwood NSW 2134</p>
        </address>
      </div>
      <div class="footer-bottom">
        <p class="footer-copyright">Copyright © 2026 Skyra Studio. All rights reserved.</p>
        <nav class="footer-legal" aria-label="Legal">
          <a href="{{ shop.policies.privacy_policy.url | default: '/policies/privacy-policy' }}">Privacy Policy</a>
          <a href="{{ shop.policies.terms_of_service.url | default: '/policies/terms-of-service' }}">Terms &amp; Conditions</a>
        </nav>
      </div>
    </footer>
</div>
{% schema %}
{
  "name": "Skyra membership",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Main menu", "default": "main-menu" },
    { "type": "url", "id": "programs_link", "label": "Programs page" },
    { "type": "url", "id": "membership_link", "label": "Membership page" },
    { "type": "url", "id": "mv_project_link", "label": "MV Project page" },
    { "type": "url", "id": "functions_link", "label": "Functions and Studio Hire page" },
    { "type": "url", "id": "about_link", "label": "About page" },
    { "type": "url", "id": "contact_link", "label": "Contact page" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "xiaohongshu_url", "label": "Rednote URL" },
    { "type": "url", "id": "facebook_url", "label": "Facebook URL" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok URL" }
  ],
  "presets": [{ "name": "Skyra membership" }],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
