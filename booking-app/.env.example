DATABASE_URL=postgresql://skyra:local-development-only@127.0.0.1:55432/skyra_booking?schema=public&connection_limit=10
REDIS_URL=redis://127.0.0.1:56379
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app-host.example
SCOPES=write_products,read_publications,write_publications,write_metaobjects,read_metaobjects,write_metaobject_definitions,read_metaobject_definitions,write_app_proxy,unauthenticated_read_product_listings,unauthenticated_write_checkouts,read_orders,read_customers
SHOPIFY_SHOP=
SKYRA_BOOKING_TEST_SHOP=
SKYRA_BOOKING_CHECKOUT_ENABLED=false
SKYRA_BOOKING_OWNED_PASSES_ENABLED=false
LOG_LEVEL=info

# Optional transactional transport; stays off until provider/domain verified.
SKYRA_MAIL_ENABLED=false
SKYRA_MEMBERSHIP_MAIL_ENABLED=false
SKYRA_MAIL_PROVIDER=resend
RESEND_API_KEY=
SKYRA_MAIL_FROM=hello@skyrastudio.com.au
SKYRA_COACH_LOGIN_SHOP=skyra-booking-dev.myshopify.com
SKYRA_BOOKING_MAIL_SHOP=skyra-booking-dev.myshopify.com
# Independent 32-byte AES key as 64 lowercase hex characters, never a Shopify secret.
SKYRA_COACH_MAIL_KEY=


# Production stays closed until all launch evidence is signed off.
SKYRA_BOOKING_PRODUCTION_SHOP=mf0n6s-zg.myshopify.com
SKYRA_BOOKING_PRODUCTION_RELEASE_APPROVED=false
SKYRA_BOOKING_PRODUCTION_CHECKOUT_ENABLED=false
SKYRA_BOOKING_PRODUCTION_OWNED_PASSES_ENABLED=false
SKYRA_BOOKING_EMERGENCY_STOP=false

# Membership purchase/renewal release gates. Keep false until test-store UAT.
SKYRA_MEMBERSHIPS_TEST_ENABLED=false
SKYRA_MEMBERSHIPS_ENABLED=false
# Requires app-owned selling plans/contracts, approved scopes and test payments.
SKYRA_MEMBERSHIPS_SUBSCRIPTIONS_READY=false
# Both shops: evidence that old/direct checkouts cannot double-charge.
SKYRA_MEMBERSHIPS_CHECKOUT_EXCLUSION_VERIFIED=false
# Native validation must be installed, enabled and block checkout on failure.
SKYRA_MEMBERSHIPS_CHECKOUT_GUARD_READY=false
SKYRA_MEMBERSHIPS_TEST_VALIDATION_GID=
SKYRA_MEMBERSHIPS_VALIDATION_GID=
# Set only from an app-created SellingPlanGroup response retained for this shop.
# A merchant-pasted plan/group ID is not ownership evidence.
SKYRA_MEMBERSHIPS_TEST_SELLING_PLAN_GROUP_GID=
SKYRA_MEMBERSHIPS_SELLING_PLAN_GROUP_GID=
