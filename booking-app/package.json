{
  "name": "skyra-booking",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "build:worker": "esbuild scripts/worker.ts --bundle --platform=node --format=esm --packages=external --outfile=build/worker/index.js && esbuild scripts/import-mindbody.ts --bundle --platform=node --format=esm --packages=external --outfile=build/ops/import-mindbody.js",
    "dev": "shopify app dev",
    "dev:stack": "concurrently --kill-others --names app,worker \"react-router dev\" \"tsx scripts/worker.ts\"",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "react-router-serve ./build/server/index.js",
    "start:worker": "node ./build/worker/index.js",
    "start:render": "node ./scripts/start-render.mjs",
    "docker-start": "npm run setup && npm run start",
    "setup": "prisma generate && prisma migrate deploy",
    "migrate:deploy": "prisma migrate deploy",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run --no-file-parallelism",
    "test:db": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-db.ps1",
    "worker": "tsx --env-file=.env scripts/worker.ts",
    "seed": "tsx --env-file=.env prisma/seed.ts",
    "check": "npm run typecheck && npm run typecheck:customer && npm run lint && npm run build",
    "build:theme-extension": "esbuild theme-extension-src/attempt.js --bundle --minify --outfile=extensions/skyra-booking-embed/assets/attempt.js && esbuild theme-extension-src/login.js --bundle --minify --outfile=extensions/skyra-booking-embed/assets/login.js && esbuild theme-extension-src/booking.js --bundle --minify --outfile=extensions/skyra-booking-embed/assets/booking.js && esbuild theme-extension-src/calendar.js --bundle --minify --outfile=extensions/skyra-booking-embed/assets/calendar.js && esbuild theme-extension-src/transaction.js --bundle --minify --outfile=extensions/skyra-booking-embed/assets/transaction.js",
    "preview:check": "node scripts/preview-health.mjs",
    "preview:purchasability": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/dev-store-purchasability.ps1",
    "preview:theme": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/dev-theme.ps1",
    "preview:app": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/dev-app.ps1",
    "typecheck:customer": "tsc --project extensions/skyra-customer-account/tsconfig.json",
    "migration:mindbody": "tsx scripts/import-mindbody.ts"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@react-router/node": "^7.12.0",
    "@react-router/serve": "^7.12.0",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^1.2.1",
    "@shopify/shopify-app-session-storage-prisma": "^9.0.0",
    "bullmq": "^6.3.4",
    "ioredis": "^6.0.0",
    "isbot": "^5.1.31",
    "luxon": "^3.7.2",
    "pino": "^10.3.1",
    "prisma": "^6.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.12.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@react-router/dev": "^7.18.3",
    "@react-router/fs-routes": "^7.18.3",
    "@shopify/api-codegen-preset": "^1.2.0",
    "@shopify/polaris-types": "^1.0.1",
    "@types/eslint": "^9.6.1",
    "@types/luxon": "^3.7.5",
    "@types/node": "^22.18.8",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "concurrently": "^10.0.5",
    "esbuild": "0.25.12",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "graphql-config": "^5.1.1",
    "prettier": "^3.6.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^6.3.6",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^5.0.0"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "p-map": "^4.0.0",
    "deepmerge-ts": "^8.0.2",
    "lodash": "^4.18.1",
    "qs": "^6.15.4",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "9.0.7"
    }
  },
  "author": "28068"
}
